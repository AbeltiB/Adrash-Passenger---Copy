# Copy this file to .env.local and fill in values before local development.
# For EAS cloud builds, add secrets via:
#   eas secret:create --scope project --name VAR_NAME --value "value"

# ── API ──────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=https://api.adrash.et/api/v1
EXPO_PUBLIC_SIGNALR_HUB_URL=https://api.adrash.et/hubs/tracking

# ── Map tiles (MapLibre — no API key required) ───────────────────────────────
# Default (OpenFreeMap — free, no sign-up): https://tiles.openfreemap.org/styles/liberty
# Alternatives: MapTiler, Stadia Maps, self-hosted
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ── Legal URLs ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://adrash.et/privacy-policy
EXPO_PUBLIC_TERMS_URL=https://adrash.et/privacy-policy

# ── Monitoring (add to EAS Secrets for production builds) ───────────────────
EXPO_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=   ← never commit this; store as EAS Secret only
