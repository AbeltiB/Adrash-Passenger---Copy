# Copy this file to .env and fill in the values before building.
# For production builds, add these as EAS Secrets:
#   eas secret:create --scope project --name EXPO_PUBLIC_SENTRY_DSN --value "your_dsn"

# Sentry DSN — found in your Sentry project → Settings → Client Keys
EXPO_PUBLIC_SENTRY_DSN=

# API base URL (include /api/v1 suffix)
EXPO_PUBLIC_API_BASE_URL=https://api.adrash.et/api/v1

# Google Maps API key (Android: enable "Maps SDK for Android" in Google Cloud).
# Without it the live-tracking and pickup maps fall back to a non-map view.
# Preferred: set it in app.json under android.config.googleMaps.apiKey and rebuild.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
